<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA1416</NoWarn>
    <PackageId>Stratum.Runtime</PackageId>
    <Version>1.0.0</Version>
    <Description>Stratum runtime: JS interop, input bridge.</Description>
    <Authors>Stratum</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stratum.Core\Stratum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\loader\main.js">
      <Pack>true</Pack>
      <PackagePath>content\wwwroot\main.js</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\loader\Stratum.js">
      <Pack>true</Pack>
      <PackagePath>content\wwwroot\Stratum.js</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
