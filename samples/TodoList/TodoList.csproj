<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAOTCompilation>false</RunAOTCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stratum.Core\Stratum.Core.csproj" />
    <ProjectReference Include="..\..\src\Stratum.Controls\Stratum.Controls.csproj" />
    <ProjectReference Include="..\..\src\Stratum.Runtime\Stratum.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Stratum.Generator\Stratum.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.stratum" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot\**" />
  </ItemGroup>

  <!-- Prevent the IL trimmer from removing [JSExport] methods in Stratum.Runtime
       and [JSImport] stubs in Stratum.Core. Neither is referenced from C# code
       directly, so the trimmer would strip them without these roots. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Stratum.Runtime" />
    <TrimmerRootAssembly Include="Stratum.Core" />
  </ItemGroup>
</Project>
