<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAOTCompilation>false</RunAOTCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stratum.Core\Stratum.Core.csproj" />
    <ProjectReference Include="..\..\src\Stratum.Controls\Stratum.Controls.csproj" />
    <ProjectReference Include="..\..\src\Stratum.Runtime\Stratum.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Stratum.Generator\Stratum.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.stratum" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Stratum.Runtime" />
    <TrimmerRootAssembly Include="Stratum.Core" />
  </ItemGroup>
</Project>
