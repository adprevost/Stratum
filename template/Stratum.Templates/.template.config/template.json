{
  "$schema": "http://json.schemastore.org/template",
  "author": "Stratum Contributors",
  "classifications": ["Web", "WebAssembly", "Canvas", "Stratum"],
  "identity": "Stratum.App.Template",
  "name": "Stratum App",
  "shortName": "stratum-app",
  "description": "A canvas-based WebAssembly app using Stratum.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "MyApp",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10.0" }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    }
  }
}
